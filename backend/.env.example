# ── Master switch ──────────────────────────────────────────────────────
# When LIVE_DATA_MODE=true, OFAC fetches the public SDN feed and the AIS
# ingester (started separately via `python -m app.ingest.run`) connects
# to AISStream. When false, the curated demo seed is the source of truth.
LIVE_DATA_MODE=false

# ── Anthropic — required for interdiction brief generation ─────────────
ANTHROPIC_API_KEY=

# ── AISStream.io — live AIS WebSocket stream (free, register + get key) ─
# https://aisstream.io
AISSTREAM_KEY=

# AIS ingester bbox: min_lat,min_lon,max_lat,max_lon
# Default: Persian Gulf (documented shadow-fleet activity)
# Other useful options:
#   Black Sea:     40.0,27.0,47.5,42.0
#   East China:    23.0,118.0,33.0,128.0
#   Strait Hormuz: 25.5,55.0,27.5,58.0
AIS_BBOX=23.0,48.0,30.5,57.0
AIS_MIN_POSITION_MSGS=3

# ── Global Fishing Watch — AIS + vessel identity (free research token) ─
# https://globalfishingwatch.org/our-apis/
GFW_TOKEN=

# ── Copernicus / Sentinel Hub — Sentinel-1 SAR imagery (free, OAuth) ───
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# ── Equasis — vessel ownership and flag history (no public API) ────────
# Stays mocked. Real Equasis requires registration and ToS-blocks scraping.
EQUASIS_SESSION=

# ── OFAC — public list, no auth ────────────────────────────────────────
OFAC_SDN_URL=https://www.treasury.gov/ofac/downloads/sdn.xml

# ── App config ─────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./shadowfleet.db
CORS_ORIGINS=http://localhost:5173
LLM_MODEL=claude-sonnet-4-5
