# Anthropic — required for interdiction brief generation
ANTHROPIC_API_KEY=

# Global Fishing Watch — AIS + vessel identity
GFW_TOKEN=

# Copernicus / Sentinel Hub — Sentinel-1 SAR imagery
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Equasis — vessel ownership and flag history (manual session token, no public API)
EQUASIS_SESSION=

# OFAC — public list, no auth, but cache locally
OFAC_SDN_URL=https://www.treasury.gov/ofac/downloads/sdn.xml

# App config
DATABASE_URL=sqlite:///./shadowfleet.db
CORS_ORIGINS=http://localhost:5173
LLM_MODEL=claude-sonnet-4-5
